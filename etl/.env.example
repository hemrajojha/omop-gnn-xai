# -------------------------------------------------------
# OHDSI_MIMIC environment variables
# Copy to .env and adjust before running the pipeline
# -------------------------------------------------------

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mimiciv_omop
POSTGRES_USER=omop_user
POSTGRES_PASSWORD=omop_pass

# Convenience DSN used by psql / run_pipeline.sh
DATABASE_URL=postgresql://omop_user:omop_pass@localhost:5432/mimiciv_omop

# Absolute paths to data directories
# (used by staging/00_load_raw_csv.sql and staging/01_load_vocab.sql)
MIMIC_HOSP_PATH=/path/to/OMOP_GNN_Project/data/raw/mimiciv/hosp
MIMIC_ICU_PATH=/path/to/OMOP_GNN_Project/data/raw/mimiciv/icu
VOCAB_PATH=/path/to/OMOP_GNN_Project/data/vocab

# pgAdmin (optional, used by docker-compose)
PGADMIN_EMAIL=admin@omop.local
PGADMIN_PASSWORD=admin

# -------------------------------------------------------
# Broadsea / ATLAS (uncomment when ready)
# -------------------------------------------------------
# WEBAPI_URL=http://localhost:8080/WebAPI
# ATLAS_URL=http://localhost:8080/atlas
# CDM_SCHEMA=omopcdm
# VOCAB_SCHEMA=omopcdm
# RESULTS_SCHEMA=results
